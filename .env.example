# Copie para .env.local (dev) e preencha. Veja ENV_contexto_ambiente.md §6.

# Banco
DATABASE_URL="postgresql://intellisuite:CHANGE_ME@localhost:5432/intellisuite"

# Auth (Better Auth) — gerar: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LLMs — chaves diretas dos 3 provedores (nomes lidos automaticamente pelos SDKs do AI SDK).
# Use conta/projeto COM faturamento: as camadas gratuitas de alguns provedores podem usar os dados.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Busca
TAVILY_API_KEY=""
SEARXNG_URL="http://localhost:8080"

# PDF escaneado / complexo (docling-serve)
DOCLING_URL="http://localhost:5001"

# Cache do modelo de embeddings (produção: volume)
HF_HOME=".cache"
